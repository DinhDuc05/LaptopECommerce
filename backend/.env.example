# ============================================================================
# BACKEND ENVIRONMENT CONFIGURATION (AWS T3.SMALL OPTIMIZED)
# ============================================================================

PORT=5000
NODE_ENV=development

# SQL Server Connection String with connection pooling limit (max 5 connections to save RAM)
# Format: sqlserver://<host>:<port>;database=<db>;user=<user>;password=<pass>;encrypt=true;trustServerCertificate=true;connection_limit=5
DATABASE_URL="sqlserver://localhost:1433;database=LaptopDB;user=sa;password=StrongPassword@123;encrypt=true;trustServerCertificate=true;connection_limit=5"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:3000"

# Rate Limit Window & Max Requests (Anti-spam on low CPU/RAM)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
